# Apex Referral Service — Environment Configuration
# Copy to .env and fill in values. Never commit .env to source control.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://apex:replace_with_long_random_password@localhost:5433/apex_referrals
# Compose services use the PostgreSQL container hostname instead of localhost.
DOCKER_DATABASE_URL=postgresql+asyncpg://apex:replace_with_long_random_password@postgres:5432/apex_referrals
POSTGRES_USER=apex
POSTGRES_PASSWORD=replace_with_long_random_password
POSTGRES_DB=apex_referrals
POSTGRES_PORT=5433
API_PORT=8000

# --- Distributed Rate Limiting ---
REDIS_URL=redis://localhost:6379/0
DOCKER_REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND_TIMEOUT_SECONDS=0.25
RATE_LIMIT_REFERRAL_PER_MINUTE=30
RATE_LIMIT_REFERRAL_BURST=10
RATE_LIMIT_STATUS_PER_MINUTE=120
RATE_LIMIT_STATUS_BURST=30
RATE_LIMIT_REPLAY_PER_MINUTE=5
RATE_LIMIT_REPLAY_BURST=2
RATE_LIMIT_AUTH_FAILURE_PER_MINUTE=10
RATE_LIMIT_AUTH_FAILURE_BURST=10

# --- Application ---
APP_ENV=development
# Containerized services default to production behavior (for example, no SQL echo).
DOCKER_APP_ENV=production
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Authentication (Mock IdP) ---
# HMAC secret used by the mock identity provider to sign/verify JWTs.
# In production, replace with the customer's IdP public key / JWKS endpoint.
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- Outbox Publisher ---
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_BATCH_SIZE=50

# --- Worker ---
WORKER_POLL_INTERVAL_SECONDS=2
# Consumer slots per worker process. Valid range: 1-8.
WORKER_CONCURRENCY=4
OUTBOX_CLAIM_LEASE_SECONDS=300

# --- Retry Policy ---
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_MS=500

# --- Idempotency ---
IDEMPOTENCY_TTL_HOURS=24
